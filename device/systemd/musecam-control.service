[Unit]
Description=Muse Cam Wi-Fi and software update service
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/lib/musecam/control.py
User=root
Group=musecam
RuntimeDirectory=musecam-control
RuntimeDirectoryMode=0750
UMask=0077
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
