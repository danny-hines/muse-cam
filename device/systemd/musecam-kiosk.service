[Unit]
Description=Muse Cam touchscreen kiosk
After=musecam.service systemd-user-sessions.service
Requires=musecam.service
PartOf=musecam.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=musecam
Group=musecam
SupplementaryGroups=video render input tty
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
Environment=XDG_RUNTIME_DIR=/run/musecam-kiosk
RuntimeDirectory=musecam-kiosk
ExecStart=/usr/bin/xinit /opt/muse-cam/device/scripts/chromium-kiosk.sh -- /usr/lib/xorg/Xorg :0 vt1 -keeptty -nolisten tcp -nocursor
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
