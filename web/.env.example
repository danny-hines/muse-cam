# Public site URL used for metadata and generated share links.
SITE_URL=http://localhost:3000

# Camera identity and authentication. Prefer the SHA-256 form in Vercel.
DEVICE_ID=muse-cam-01
DEVICE_API_TOKEN=replace-with-a-long-random-token
# DEVICE_API_TOKEN_SHA256=

# Use "mock" for local/Vercel smoke tests or "meta" for Muse Image.
MODEL_PROVIDER=mock
META_API_KEY=
META_MODEL_ID=
# Full authenticated Responses API endpoint from the current Meta Model API docs.
META_MODEL_API_URL=

# Provision Neon through the Vercel Marketplace.
DATABASE_URL=

# Connect one private and one public Vercel Blob store with these custom prefixes.
PRIVATE_BLOB_READ_WRITE_TOKEN=
PUBLISHED_BLOB_READ_WRITE_TOKEN=

# Show included demo frames when no persistent database is connected.
DEMO_MODE=true
